# Copy this file to .env and fill in the values. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# PostgreSQL password (also used by the API to connect).
POSTGRES_PASSWORD=

# Service key used by the agent and the pipeline (at least 24 characters).
SENTINEL_API_KEY=

# Signs user login tokens (at least 32 characters). Required for dashboard sign-in.
SENTINEL_AUTH_SECRET=

# Grafana admin password.
GRAFANA_ADMIN_PASSWORD=

# This host's name, shown on every event and incident.
SENTINEL_HOST_ID=sentinel-host
SENTINEL_INTERVAL_SECONDS=60
SENTINEL_COLLECTORS=system,processes,network,auth

# Numeric id of the host's systemd-journal group (lets the agent read the SSH journal).
# On the host run:  getent group systemd-journal | cut -d: -f3
SENTINEL_JOURNAL_GID=

# Listening ports that are expected on this host (comma-separated). Any other listening port
# raises an "unexpected port" detection. Leave empty to learn the baseline instead.
SENTINEL_ALLOWED_PORTS=22,80,443,3000,3001,5432,6379,8000,9090

# Optional: AI analysis. "rules" (default) sends nothing outside this host.
SENTINEL_AI_PROVIDER=rules
SENTINEL_AI_API_KEY=

# Optional: email alerts. Leave SMTP_HOST empty to disable.
SENTINEL_SMTP_HOST=
SENTINEL_SMTP_PORT=587
SENTINEL_SMTP_USERNAME=
SENTINEL_SMTP_PASSWORD=
SENTINEL_SMTP_FROM=
SENTINEL_ALERT_RECIPIENTS=
